                            {
                              "type": "text",
                              "id": "MPHtW",
                              "name": "Paragraph",
                              "fill": "$pg-ink-soft",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "I started with C# and never really left. Today I build production .NET services — ASP.NET Core APIs, PostgreSQL schemas, Redis caches and background jobs — for products that people open every day.",
                              "lineHeight": 1.72,
                              "fontFamily": "$body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "TGXfd",
                              "name": "Paragraph",
                              "fill": "$pg-ink-soft",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "My work at EnglishAI is a good example of what I enjoy: the platform needed to feel faster and lose fewer students. I worked on the API, but the win came from reading telemetry, finding a false anti-cheat trigger that pushed 21 of 27 students out of a placement test, and rebuilding the recovery flow. Onboarding completion went up 78%.",
                              "lineHeight": 1.72,
                              "fontFamily": "$body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "Cvj3E",
                              "name": "Paragraph",
                              "fill": "$pg-ink-soft",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Outside of work I study Computer Science at PDP University and build products end to end. KitobdagiMen is a social reading platform with a 60/40 algorithmic feed. TypingWar is a real-time typing arena with sub-30 ms synchronisation. ZiyoAI is a multimodal Telegram assistant. MeningVaqtim keeps track of deep work across time zones. Different domains, same habits: measure first, cache what's expensive, and never trust the client.",
                              "lineHeight": 1.72,
                              "fontFamily": "$body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
