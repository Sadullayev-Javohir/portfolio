                                  "name": "Line",
                                  "fill": "#B9B0A4",
                                  "content": "> When sub-30ms keystroke latency is your core feature, HTTP polling is dead.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "Igkja",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": " ",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "AeVFG",
                                  "name": "Line",
                                  "fill": "$pg-sky",
                                  "content": "## 01. The Architecture of Trust",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "kbK1b",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": "In competitive typing, the client is the least trustworthy witness.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "TpqAu",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": "To eliminate spoofing, every keystroke cadence is verified server-side:",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "ikd9M",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": " ",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "qMUmU",
                                  "name": "Line",
                                  "fill": "$mint",
                                  "content": "```csharp",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "J8A4hq",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": "public async Task<bool> VerifyCadenceAsync(KeystrokeEvent evt) {",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "zZcHS",
                                  "name": "Line",
                                  "fill": "$pg-sky",
                                  "content": "    var expected = _clock.GetDelta(evt.Timestamp);",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "SmJvH",
                                  "name": "Line",
                                  "fill": "$coral",
                                  "content": "    if (evt.IntervalMs < expected - Tolerance)",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "VVnsA",
                                  "name": "Line",
                                  "fill": "$yellow",
                                  "content": "        throw new AntiCheatCadenceMismatchException(evt.UserId);",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "TJERI",
                                  "name": "Line",
                                  "fill": "$mint",
                                  "content": "    return await _pubsub.BroadcastProgressAsync(evt.RoomId, evt.Wpm);",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "qhrUC",
                                  "name": "Line",
                                  "fill": "$cream",
                                  "content": "}",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "KWjuB",
                                  "name": "Line",
                                  "fill": "$mint",
                                  "content": "```",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 9.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
