                              "children": [
                                {
                                  "type": "text",
                                  "id": "s94sD",
                                  "name": "Metric",
                                  "fill": "$ink",
                                  "content": "21 / 27",
                                  "fontFamily": "$heading",
                                  "fontSize": 44,
                                  "fontWeight": "700",
                                  "letterSpacing": -2
