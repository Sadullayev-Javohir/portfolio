                                {
                                  "type": "text",
                                  "id": "rGzQI",
                                  "name": "Label",
                                  "fill": "$muted",
                                  "content": "per unique prompt",
                                  "fontFamily": "$mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal",
                                  "letterSpacing": 0.6
