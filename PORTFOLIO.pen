                    },
                    {
                      "type": "frame",
                      "id": "jty7k",
                      "name": "Article Body",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 22,
                      "children": [
                        {
                          "type": "text",
                          "id": "IjGa1",
                          "name": "Intro",
                          "fill": "$pg-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Pronunciation assessment is not cheap. Every attempt sends audio to Azure Speech, comes back with a transcript and a score, and lands on the invoice. On EnglishAI the same short prompts were requested hundreds of times a day — different students, identical audio.",
                          "lineHeight": 1.75,
                          "fontFamily": "$body",
                          "fontSize": 16.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Q6dwYQ",
                          "name": "H2",
                          "fill": "$ink",
                          "content": "01. The obvious cache is the wrong cache",
                          "fontFamily": "$heading",
                          "fontSize": 26,
                          "fontWeight": "700",
                          "letterSpacing": -0.8
                        },
                        {
                          "type": "text",
                          "id": "rVQQL",
                          "name": "P",
                          "fill": "$pg-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The first instinct is to key the cache by user: one bucket per student, easy to invalidate, no accidental sharing. It is also close to useless here. A new student requesting the same phrase is a cache miss by definition, and the expensive call happens again.",
                          "lineHeight": 1.75,
                          "fontFamily": "$body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "oqoDt",
                          "name": "Code Block",
                          "clip": true,
                          "width": "fill_container",
                          "fill": "$ink",
                          "cornerRadius": 16,
                          "stroke": "$ink",
                          "strokeWidth": 2,
                          "layout": "vertical",
                          "children": [
                            {
                              "type": "frame",
                              "id": "AOUGx",
                              "name": "Code Head",
                              "width": "fill_container",
                              "stroke": "#3A342E",
                              "strokeWidth": {
                                "bottom": 1
                              },
                              "padding": [
                                12,
                                18
                              ],
                              "justifyContent": "space_between",
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "S3NqX",
                                  "name": "Lang",
                                  "gap": 8,
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "ellipse",
                                      "id": "h1obG",
                                      "name": "Dot",
                                      "fill": "$mint",
                                      "width": 7,
                                      "height": 7
                                    },
                                    {
                                      "type": "text",
                                      "id": "ufjcP",
                                      "name": "Label",
                                      "fill": "#B9B0A4",
                                      "content": "C# · SpeechCache.cs",
                                      "fontFamily": "$mono",
                                      "fontSize": 8.5,
                                      "fontWeight": "normal",
                                      "letterSpacing": 0.3
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "SKu2o",
                                  "name": "Copy",
                                  "gap": 6,
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "icon",
                                      "id": "IbZy8",
                                      "name": "Icon",
                                      "width": 11,
                                      "height": 11,
                                      "icon": "copy",
                                      "library": "lucide",
                                      "fill": "#B9B0A4"
                                    },
                                    {
                                      "type": "text",
                                      "id": "z7BjMa",
                                      "name": "Text",
                                      "fill": "#B9B0A4",
                                      "content": "COPY",
                                      "fontFamily": "$mono",
                                      "fontSize": 7.5,
                                      "fontWeight": "normal",
                                      "letterSpacing": 0.8
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "Fzi9E",
                              "name": "Code Body",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 3,
                              "padding": [
                                16,
                                20,
                                18,
                                20
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "feYBy",
                                  "name": "Code Line",
                                  "fill": "#8F8678",
                                  "content": "// the key is derived from content, not identity",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "GEBmj",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "var key = $\"tts:{Hash(text, voice, locale)}\";",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "WqnSf",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": " ",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "WfDW6",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "var cached = await _cache.GetAsync<AudioAsset>(key);",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "WqkqX",
                                  "name": "Code Line",
                                  "fill": "#000000",
                                  "content": "if (cached is not null)",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "mEJUU",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "    return cached;",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "nayAm",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": " ",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "ovKTs",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "var audio = await _speech.SynthesizeAsync(text, voice, locale);",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "yoiUt",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "await _cache.SetAsync(key, audio, TimeSpan.FromDays(30));",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                },
                                {
                                  "type": "text",
                                  "id": "potKU",
                                  "name": "Code Line",
                                  "fill": "$cream",
                                  "content": "return audio;",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
                                  "fontSize": 10.5,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.1
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "wson3",
                          "name": "Caption",
                          "fill": "$muted",
                          "content": "Illustrative implementation — the production version also tracks hit rate and asset size.",
                          "fontFamily": "$mono",
                          "fontSize": 8.5,
                          "fontWeight": "normal",
                          "letterSpacing": 0.2
                        },
                        {
                          "type": "text",
                          "id": "i0bcu",
                          "name": "H2 2",
                          "fill": "$ink",
                          "content": "02. Hash the content, keep the TTL boring",
                          "fontFamily": "$heading",
                          "fontSize": 26,
                          "fontWeight": "700",
                          "letterSpacing": -0.8
                        },
                        {
                          "type": "text",
                          "id": "N6ZBpk",
                          "name": "P 2",
                          "fill": "$pg-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The key became an MD5 hash of the text, voice and locale. Identical prompts now share one asset, and personalisation is untouched because the output was never personal in the first place. A long TTL is fine for static content — the invalidation risk is in the voice or locale, which are part of the key.",
                          "lineHeight": 1.75,
                          "fontFamily": "$body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "K3cStR",
                          "name": "Callout",
                          "width": "fill_container",
                          "fill": "$yellow",
                          "cornerRadius": 14,
                          "stroke": "$ink",
                          "strokeWidth": 2,
                          "gap": 14,
                          "padding": [
                            18,
                            20
                          ],
                          "children": [
                            {
                              "type": "icon",
                              "id": "Bsvcs",
                              "name": "Icon",
                              "width": 18,
                              "height": 18,
                              "icon": "triangle-alert",
                              "library": "lucide",
                              "fill": "$ink"
                            },
                            {
                              "type": "frame",
                              "id": "d13nAL",
                              "name": "Copy",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 4,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "N4QZF3",
                                  "name": "Title",
                                  "fill": "$ink",
                                  "content": "Only cache content-derived output",
                                  "fontFamily": "$body",
                                  "fontSize": 13,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "text",
                                  "id": "JdZiA",
                                  "name": "Text",
                                  "fill": "$pg-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Never put a user identifier in a shared key. If the response depends on who asked, the cache key must too.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$body",
                                  "fontSize": 12.5,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "SO5Jl",
                          "name": "H2 3",
                          "fill": "$ink",
                          "content": "03. What it changed",
                          "fontFamily": "$heading",
                          "fontSize": 26,
                          "fontWeight": "700",
                          "letterSpacing": -0.8
                        },
                        {
                          "type": "frame",
                          "id": "WOuy7",
                          "name": "Result Row",
                          "width": "fill_container",
                          "children": [
                            {
                              "type": "frame",
