                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "w14mD",
                          "name": "P 3",
                          "fill": "$pg-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The assessment scores themselves still come from Azure on the first request. The cache only removes the repeat work — which turned out to be most of the bill.",
                          "lineHeight": 1.75,
                          "fontFamily": "$body",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "y5eQdQ",
                          "name": "Quote",
                          "width": "fill_container",
                          "fill": "$paper",
                          "stroke": "$ink",
                          "strokeWidth": {
                            "left": 4
                          },
                          "gap": 16,
                          "padding": [
                            20,
                            24
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "qJjZx",
                              "name": "Text",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "“Cache the expensive thing, not the whole request. The smallest correct key is usually the cheapest one.”",
                              "lineHeight": 1.4,
                              "fontFamily": "$heading",
                              "fontSize": 20,
                              "fontWeight": "500",
                              "letterSpacing": -0.4
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "VA8Zt",
                          "name": "H2 4",
                          "fill": "$ink",
                          "content": "04. Eviction & monitoring",
                          "fontFamily": "$heading",
                          "fontSize": 26,
                          "fontWeight": "700",
                          "letterSpacing": -0.8
                        },
